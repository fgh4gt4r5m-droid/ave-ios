// Réglages DEBUG. Aucune clé, aucun jeton ici. Surcharges locales non committées : Config/Secrets.xcconfig (ignoré par git).
// Astuce : « $()/ » évite que « // » soit lu comme un commentaire.
AVE_ENDPOINT = ws:/$()/localhost:8787/v1/stream
AVE_ALLOW_INSECURE_LOCAL = YES
// Vide en développement : l'app utilise alors le FAUX service de comptes (DEBUG seulement, code « 000000 »).
AVE_ACCOUNTS_URL =
AVE_DEFAULT_COUNTRY_CODE = 224
AVE_APPATTEST_ENV = development
// YES tant que le moteur répond par écho avec une voix de test : l'app affiche un avis « Version d'essai ».
AVE_DEMO_ENGINE = YES
// YES seulement dans le workflow ave-testflight-demo : faux service de comptes (code 000000), jamais publiable.
AVE_DEMO_ACCOUNTS = NO
// YES seulement dans le workflow ave-testflight-demo : moteur de démo hors ligne sur l'iPhone, annoncé à l'écran.
AVE_DEMO_OFFLINE = NO
#include? "Secrets.xcconfig"
