// Réglages RELEASE. Les adresses ci-dessous sont des PLACEHOLDERS (domaine « .example », inexistant) : à remplacer par les
// vraies adresses (ici ou par variables d'environnement Codemagic passées à xcodebuild). wss/https uniquement.
AVE_ENDPOINT = wss:/$()/api.ave.example/v1/stream
AVE_ALLOW_INSECURE_LOCAL = NO
AVE_ACCOUNTS_URL = https:/$()/accounts.ave.example
AVE_DEFAULT_COUNTRY_CODE = 224
AVE_APPATTEST_ENV = production
