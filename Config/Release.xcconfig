// Réglages RELEASE. wss/https uniquement. Le workflow ave-testflight les remplace par le groupe de variables « ave » de
// Codemagic. Moteur : adresse réelle sur Render (vérifiée le 2026-10-23). Comptes : encore un PLACEHOLDER (« .example »,
// inexistant) tant que le service ave-accounts n'est pas créé sur Render.
AVE_ENDPOINT = wss:/$()/ave-engine.onrender.com/v1/stream
AVE_ALLOW_INSECURE_LOCAL = NO
AVE_ACCOUNTS_URL = https:/$()/accounts.ave.example
AVE_DEFAULT_COUNTRY_CODE = 224
AVE_APPATTEST_ENV = production
// YES tant que le moteur répond par écho avec une voix de test : l'app affiche un avis « Version d'essai ».
AVE_DEMO_ENGINE = YES
// YES seulement dans le workflow ave-testflight-demo : faux service de comptes (code 000000), jamais publiable.
AVE_DEMO_ACCOUNTS = NO
// YES seulement dans le workflow ave-testflight-demo : moteur de démo hors ligne sur l'iPhone, annoncé à l'écran.
AVE_DEMO_OFFLINE = NO
